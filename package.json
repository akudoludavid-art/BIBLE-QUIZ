{
  "name": "bible-mastery",
  "version": "0.1.0",
  "private": true,
  "description": "Preservation-first migration of the existing Bible Mastery application",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "extract": "node scripts/extract-legacy.cjs",
    "audit:source": "node scripts/forensic-inventory.cjs",
    "audit:baseline": "node scripts/phase0-browser.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/domain src/lib tests/unit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:archive": "node scripts/verify-archive.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
